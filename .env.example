# ── PostgreSQL (docker-compose.dev.yml) ───────────────────────────────
POSTGRES_USER=ats_dev
POSTGRES_PASSWORD=ats_dev
POSTGRES_DB=ats_dev
DATABASE_URL=postgres://ats_dev:ats_dev@localhost:5432/ats_dev

# ── API ────────────────────────────────────────────────────────────────
# Validadas con zod al arrancar (apps/api/src/config/env.validation.ts):
# PORT y DATABASE_URL son obligatorias; NODE_ENV ∈ development|test|production.
# CORS_ORIGIN es una lista CSV de orígenes permitidos (opcional).
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Directorio de almacenamiento de CVs subidos (Fase 4).
UPLOAD_DIR=data/uploads

# ── Seed inicial (Fase 1) ──────────────────────────────────────────────
# Contraseña del usuario admin creado por el seed. En producción se
# genera un valor aleatorio y se rota; NUNCA se versiona.
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_EMAIL=admin@larco.co
ADMIN_INITIAL_NAME=Administrador RRHH
SUPER_INITIAL_EMAIL=it@larco.co
SUPER_INITIAL_NAME=Superusuario IT
SUPER_INITIAL_PASSWORD=

# ── WEB (proxy de desarrollo hacia la API) ─────────────────────────────
API_PROXY_TARGET=http://localhost:3000

# ── Fase 2: seguridad ─────────────────────────────────────────────────
# Obligatorias. Generar en local:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # CRYPTO_KEY_BASE64
JWT_SECRET=
JWT_TTL_HOURS=24
CRYPTO_KEY_BASE64=
# Rotación planificada de la llave de cifrado: al rotar, la vigente va aquí.
# CRYPTO_KEY_PREVIOUS_BASE64=

# ── Fase 4: hash de búsqueda de PII (HMAC-SHA-256) ──────────────────────
# Secret para hashear la cédula en la columna de búsqueda (búsqueda exacta
# sin descifrar). Dedicado y NO rotar junto a CRYPTO_KEY: si se rota, hay
# que recalcular todos los hashes. Generar igual que CRYPTO_KEY_BASE64.
CEDULA_SEARCH_KEY=
