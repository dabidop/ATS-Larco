# ── PostgreSQL (docker-compose.dev.yml) ───────────────────────────────
POSTGRES_USER=ats_dev
POSTGRES_PASSWORD=ats_dev
POSTGRES_DB=ats_dev
DATABASE_URL=postgres://ats_dev:ats_dev@localhost:5432/ats_dev

# ── API ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── WEB (proxy de desarrollo hacia la API) ─────────────────────────────
API_PROXY_TARGET=http://localhost:3000

# ── Fase 2: seguridad (se generan al implementar auth) ─────────────────
# JWT_SECRET=
# JWT_TTL_HOURS=24
# CRYPTO_KEY_BASE64=   # 32 bytes en base64 para AES-256-CBC
